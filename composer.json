{
  "name": "extendssoftware/exa-php-2",
  "description": "The successor to the PHP library ExaPHP.",
  "type": "library",
  "homepage": "https://github.com/extendssoftware/exa-php-2",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "ext-uri": "*"
  },
  "require-dev": {
    "ext-pcntl": "*",
    "ext-posix": "*",
    "phpunit/phpunit": "^13.4"
  },
  "suggest": {
    "ext-pcntl": "Enables graceful SIGTERM/SIGINT shutdown for persistent outbox CLI workers."
  },
  "autoload": {
    "psr-4": {
      "ExtendsSoftware\\ExaPHP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ExtendsSoftware\\ExaPHP\\Tests\\": "tests/"
    }
  }
}
