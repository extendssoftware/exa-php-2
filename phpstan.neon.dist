parameters:
    level: max
    phpVersion: 80500
    treatPhpDocTypesAsCertain: false
    paths:
        - src
    tmpDir: .phpstan.cache
    ignoreErrors:
        # Construction and with() index each metadata object by its exact concrete class.
        -
            rawMessage: 'Method ExtendsSoftware\ExaPHP\Cqrs\DispatchContext::get() should return T of object but returns object.'
            identifier: return.type
            path: src/Cqrs/DispatchContext.php
            count: 1
            reportUnmatched: true
        # Construction and with() index each metadata object by its exact concrete class.
        -
            rawMessage: 'Method ExtendsSoftware\ExaPHP\Http\Message\RequestAttributes::get() should return T of object but returns object.'
            identifier: return.type
            path: src/Http/Message/RequestAttributes.php
            count: 1
            reportUnmatched: true
        # Keep defensive translation of reflection failures for module registration.
        -
            rawMessage: 'Dead catch - ReflectionException is never thrown in the try block.'
            identifier: catch.neverThrown
            path: src/Application/Application.php
            count: 1
            reportUnmatched: true
        # Shutdown can be requested asynchronously between stopRequested() calls.
        -
            rawMessage: 'Negated boolean expression is always true.'
            identifier: booleanNot.alwaysTrue
            path: src/Integration/Messaging/Worker/ConsumeCommand.php
            count: 1
            reportUnmatched: true
        # Shutdown can be requested asynchronously between stopRequested() calls.
        -
            rawMessage: 'Negated boolean expression is always true.'
            identifier: booleanNot.alwaysTrue
            path: src/Integration/Outbox/Worker/WorkCommand.php
            count: 1
            reportUnmatched: true
